{
  "name": "electron-notes-tutorial",
  "version": "1.0.0",
  "private": true,
  "productName": "Electron Notes",
  "author": "Electron Notes Tutorial Contributors",
  "description": "贯穿 Electron 教程的本地笔记应用",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run security:check",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "artifact:check": "node scripts/artifact-check.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "electron": "43.4.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.2.1"
  }
}
